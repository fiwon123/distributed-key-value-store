# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.*
!.env.example
.envrc

# Dev sandbox artifacts — Go module/build caches and runtime state live in
# /workspace (mounted from the repo root), so they must never be committed.
/tmp/
/.go/
/.xdg-data/
/.xdg-cache/
/.xdg-state/
air.log

# Agent session memory (local-only, never committed)
.opencode/memory/
__pycache__/

# Frontend
web/node_modules/
web/dist/
web/coverage/
/internal/webui/dist/*
!/internal/webui/dist/placeholder.html

# Editor/IDE
# .idea/
# .vscode/
